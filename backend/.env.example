# EventRoute Backend Configuration
# Store sensitive keys here only - NEVER commit actual keys to version control

# TinyFish Web Agent API Key (Get from https://tinyfish.ai)
TINYFISH_API_KEY=

# Server Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Routing Provider Configuration
OSRM_BASE_URL=https://router.project-osrm.org
ROUTING_TIMEOUT_SECONDS=6.0
TINYFISH_TIMEOUT_SECONDS=8.0
CACHE_TTL_SECONDS=600
